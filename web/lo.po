msgstr "ການຕັ້ງຄ່ານີ້ແມ່ນສຳລັບອ່ານຢ່າງດຽວ."

#. TRANSLATORS: menu entry to download the installer logs as an archive
#: src/components/core/DownloadLogsButton.tsx:46
#: src/components/core/InstallerOptionsMenu.tsx:123
msgid "Download logs"
msgstr "ດາວໂຫຼດໄຟລ໌ບັນທຶກ (Logs)"

#: src/components/core/DownloadLogsFeedback.tsx:34
#, javascript-format
msgid ""
"The file %s contains a record of the installer activity so far, useful to "
"diagnose installation issues."
msgstr ""
"ໄຟລ໌ %s ປະກອບມີບັນທຶກກິດຈະກຳຂອງຕົວຕິດຕັ້ງທີ່ຜ່ານມາ, ເຊິ່ງມີປະໂຫຍດໃນການກວດສອບບັນຫາການຕິດຕັ້ງ."

#. TRANSLATORS: alert title for installation logs download
#: src/components/core/DownloadLogsFeedback.tsx:43
msgid "Installation logs download"
msgstr "ດາວໂຫຼດໄຟລ໌ບັນທຶກການຕິດຕັ້ງ"

#: src/components/core/DownloadLogsFeedback.tsx:56
msgid ""
"Data collection may take a while. The download will start automatically once "
"the file is ready."
msgstr "ການລວບລວມຂໍ້ມູນອາດໃຊ້ເວລາບຶດໜຶ່ງ. ການດາວໂຫຼດຈະເລີ່ມຂຶ້ນໂດຍອັດຕະໂນມັດເມື່ອໄຟລ໌ພ້ອມແລ້ວ."

#: src/components/core/ErrorPage.tsx:85
msgid "Retrieving error details"
msgstr "ກຳລັງດຶງລາຍລະອຽດຂໍ້ຜິດພາດ"

#: src/components/core/ErrorPage.tsx:134
#: src/components/storage/EncryptionSettingsPage.tsx:128
#: src/components/storage/iscsi/DiscoverFormPage.tsx:175
#: src/components/storage/iscsi/TargetLoginPage.tsx:188
