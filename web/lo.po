#: src/components/core/AlertOutOfSync.tsx:71
msgid "Configuration out of sync"
msgstr "ການຕັ້ງຄ່າບໍ່ກົງກັນ"

#: src/components/core/AlertOutOfSync.tsx:80
msgid "The configuration has been updated externally."
msgstr "ການຕັ້ງຄ່າໄດ້ຖືກອັບເດດຈາກພາຍນອກ."

#: src/components/core/AlertOutOfSync.tsx:82
msgid ""
"Reloading is required to get the latest data and avoid issues or data loss."
msgstr "ຈຳເປັນຕ້ອງໂຫຼດໃໝ່ເພື່ອໃຫ້ໄດ້ຂໍ້ມູນຫຼ້າສຸດ ແລະ ເພື່ອຫຼີກລ່ຽງບັນຫາ ຫຼື ການສູນເສຍຂໍ້ມູນ."

#: src/components/core/AlertOutOfSync.tsx:85
msgid "Reload now"
msgstr "ໂຫຼດໃໝ່ດຽວນີ້"

#: src/components/core/ChangeProductOption.tsx:45
